# ==============================================================================
# MEGA FREELANCER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values below.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE & AI EVALUATION (Required)
# ------------------------------------------------------------------------------
# GROQ_API_KEY: Required for the AI opportunity evaluator and proposal generation.
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# GITHUB INTEGRATION (Required for GitHub scanner and submissions)
# ------------------------------------------------------------------------------
# GITHUB_TOKEN: Required for scanning GitHub repositories and automatically submitting applications.
GITHUB_TOKEN=your_github_token_here

# ------------------------------------------------------------------------------
# TELEGRAM NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# Provide these to enable outbound Telegram alerts when opportunities are found or payments arrive.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_NOTIFICATIONS_ENABLED=true

# ------------------------------------------------------------------------------
# WORKER & ENGINE SETTINGS (Optional)
# ------------------------------------------------------------------------------
# WORKER_SCAN_INTERVAL: Seconds between scan cycles (default: 300)
WORKER_SCAN_INTERVAL=300
# LIVE_SUBMISSION: Set to 'true' to actually submit applications. Default is 'false' (DRY RUN).
LIVE_SUBMISSION=false

